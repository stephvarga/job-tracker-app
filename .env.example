# Supabase project: Settings → Data API → Project URL
VITE_SUPABASE_URL=your_supabase_project_url

# Supabase: Settings → API Keys → Publishable key.
# This ships in the browser bundle and is meant to be public. Row-level
# security is what protects your data; supabase/schema.sql sets it up.
# Never put the service_role key here.
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_key

# IANA timezone your shop's workday is measured in. Days and weeks are
# calculated in this zone, not the viewing device's, so hours land on the
# right day even if someone checks from a phone in another state.
# Must be a full IANA name ("America/Chicago"), not an abbreviation ("CST").
VITE_SHOP_TZ=America/Los_Angeles
